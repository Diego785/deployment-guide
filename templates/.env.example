# Copy to .env on the server, fill in real values, then: chmod 600 .env
# Generate secrets with: openssl rand -hex 24   (letters and digits only: safe inside URLs)

# Image version to run (see docs/11-updates-and-rollback.md)
APP_TAG=1.0.0

# Database (read by the db service and by the app)
POSTGRES_DB=my_app
POSTGRES_USER=my_app
POSTGRES_PASSWORD=change-me

# The host is the database CONTAINER's name, not localhost
DATABASE_URL=postgres://my_app:change-me@my-app-db:5432/my_app

# App
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
APP_URL=https://app.example.com
SESSION_SECRET=change-me
